{%- comment -%}
  sections/custom-design-test.liquid
  Component showcase / design test section.
  Visualizes the design system (buttons, headings, body text, product card)
  based on values defined in design.json.
{%- endcomment -%}

<section class="custom-design-test section-{{ section.id }}">
  <div class="custom-design-test__inner page-width">

    <!-- TYPOGRAPHY -->
    <div class="custom-design-test__group">
      <h2 class="custom-design-test__group-title">
        {{ section.settings.typography_group_title | default: 'טיפוגרפיה' }}
      </h2>

      <h1 class="cdt-heading-1">
        {{ section.settings.typography_h1 | default: 'כותרת H1 – חדרי תינוקות רכים ונעימים' }}
      </h1>
      <h2 class="cdt-heading-2">
        {{ section.settings.typography_h2 | default: 'כותרת H2 – מיטות, שידות וסטים מלאים' }}
      </h2>
      <h3 class="cdt-heading-3">
        {{ section.settings.typography_h3 | default: 'כותרת H3 – טקסט משני / כותרת בלוק' }}
      </h3>

      <p class="cdt-body">
        {{ section.settings.typography_body | default: 'זהו טקסט פסקה רגיל. אמור להיראות נקי, קריא ורך, עם מרווח שורות נעים לעין, מתאים לתיאורי מוצרים, תיאורי קטגוריות ותכנים כלליים באתר.' }}
      </p>

      <p class="cdt-body-small">
        {{ section.settings.typography_body_small | default: 'זהו טקסט משני קטן יותר (לתיוגים, תוויות, הערות קטנות).' }}
      </p>
    </div>

    <!-- BUTTONS -->
    <div class="custom-design-test__group">
      <h2 class="custom-design-test__group-title">
        {{ section.settings.buttons_group_title | default: 'כפתורים' }}
      </h2>

      <div class="custom-design-test__buttons-row">
        <a href="#" class="cdt-button cdt-button--primary">
          {{ section.settings.primary_button_label | default: 'כפתור ראשי' }}
        </a>
        <a href="#" class="cdt-button cdt-button--secondary">
          {{ section.settings.secondary_button_label | default: 'כפתור משני' }}
        </a>
        <button type="button" class="cdt-button-icon" aria-label="אייקון">
          {{ section.settings.icon_button_label | default: '♥' }}
        </button>
      </div>

      <p class="cdt-note">
        {{ section.settings.buttons_note | default: 'הכפתור הראשי משתמש בצבע המותג #CDB9A2 (primary), הכפתור המשני בקו מסגרת עדין על רקע בהיר.' }}
      </p>
    </div>

    <!-- PRODUCT CARD -->
    <div class="custom-design-test__group">
      <h2 class="custom-design-test__group-title">
        {{ section.settings.product_group_title | default: 'כרטיס מוצר לדוגמה' }}
      </h2>

      <div class="cdt-product-card">
        <div class="cdt-product-card__image-wrapper">
          {%- if section.settings.product_image != blank -%}
            {{ section.settings.product_image
              | image_url: width: 400
              | image_tag: loading: 'lazy', alt: section.settings.product_title
            }}
          {%- else -%}
            <div class="cdt-product-card__placeholder">
              תמונת מוצר
            </div>
          {%- endif -%}
        </div>

        <div class="cdt-product-card__content">
          <p class="cdt-product-card__brand">
            {{ section.settings.product_brand | default: 'מותג לדוגמה' }}
          </p>
          <h3 class="cdt-product-card__title">
            {{ section.settings.product_title | default: 'מיטת תינוק דגם עמית לבן' }}
          </h3>

          <div class="cdt-product-card__prices">
            <span class="cdt-product-card__price">
              {{ section.settings.product_price | default: '₪ 1,390' }}
            </span>
            <span class="cdt-product-card__club-price">
              {{ section.settings.product_club_price | default: '₪ 1,190 לחברי מועדון' }}
            </span>
          </div>

          <div class="cdt-product-card__actions">
            <a href="#" class="cdt-button cdt-button--primary cdt-product-card__cta">
              {{ section.settings.product_primary_cta | default: 'הוסף לסל' }}
            </a>
            <a href="#" class="cdt-link">
              {{ section.settings.product_secondary_cta | default: 'קנה עכשיו' }}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- COLLECTION PAGE EXAMPLE -->
    <div class="custom-design-test__group">
      <h2 class="custom-design-test__group-title">
        {{ section.settings.collection_group_title | default: 'דוגמה לדף קולקציה' }}
      </h2>

      <div class="cdt-collection-grid">
        <!-- Product Card 1 -->
        <div class="cdt-product-card">
          <div class="cdt-product-card__image-wrapper">
            {%- if section.settings.collection_product_1_image != blank -%}
              {{ section.settings.collection_product_1_image
                | image_url: width: 400
                | image_tag: loading: 'lazy', alt: section.settings.collection_product_1_title
              }}
            {%- else -%}
              <div class="cdt-product-card__placeholder">
                תמונת מוצר
              </div>
            {%- endif -%}
          </div>
          <div class="cdt-product-card__content">
            <p class="cdt-product-card__brand">
              {{ section.settings.collection_product_1_brand | default: 'מותג לדוגמה' }}
            </p>
            <h3 class="cdt-product-card__title">
              {{ section.settings.collection_product_1_title | default: 'מיטת תינוק דגם עמית לבן' }}
            </h3>
            <div class="cdt-product-card__prices">
              <span class="cdt-product-card__price">
                {{ section.settings.collection_product_1_price | default: '₪ 1,390' }}
              </span>
              <span class="cdt-product-card__club-price">
                {{ section.settings.collection_product_1_club_price | default: '₪ 1,190 לחברי מועדון' }}
              </span>
            </div>
            <div class="cdt-product-card__actions">
              <a href="#" class="cdt-button cdt-button--primary cdt-product-card__cta">
                {{ section.settings.collection_product_1_cta | default: 'הוסף לסל' }}
              </a>
            </div>
          </div>
        </div>

        <!-- Product Card 2 -->
        <div class="cdt-product-card">
          <div class="cdt-product-card__image-wrapper">
            {%- if section.settings.collection_product_2_image != blank -%}
              {{ section.settings.collection_product_2_image
                | image_url: width: 400
                | image_tag: loading: 'lazy', alt: section.settings.collection_product_2_title
              }}
            {%- else -%}
              <div class="cdt-product-card__placeholder">
                תמונת מוצר
              </div>
            {%- endif -%}
          </div>
          <div class="cdt-product-card__content">
            <p class="cdt-product-card__brand">
              {{ section.settings.collection_product_2_brand | default: 'מותג לדוגמה' }}
            </p>
            <h3 class="cdt-product-card__title">
              {{ section.settings.collection_product_2_title | default: 'שידת החתלה דגם נועה' }}
            </h3>
            <div class="cdt-product-card__prices">
              <span class="cdt-product-card__price">
                {{ section.settings.collection_product_2_price | default: '₪ 890' }}
              </span>
              <span class="cdt-product-card__club-price">
                {{ section.settings.collection_product_2_club_price | default: '₪ 750 לחברי מועדון' }}
              </span>
            </div>
            <div class="cdt-product-card__actions">
              <a href="#" class="cdt-button cdt-button--primary cdt-product-card__cta">
                {{ section.settings.collection_product_2_cta | default: 'הוסף לסל' }}
              </a>
            </div>
          </div>
        </div>

        <!-- Product Card 3 -->
        <div class="cdt-product-card">
          <div class="cdt-product-card__image-wrapper">
            {%- if section.settings.collection_product_3_image != blank -%}
              {{ section.settings.collection_product_3_image
                | image_url: width: 400
                | image_tag: loading: 'lazy', alt: section.settings.collection_product_3_title
              }}
            {%- else -%}
              <div class="cdt-product-card__placeholder">
                תמונת מוצר
              </div>
            {%- endif -%}
          </div>
          <div class="cdt-product-card__content">
            <p class="cdt-product-card__brand">
              {{ section.settings.collection_product_3_brand | default: 'מותג לדוגמה' }}
            </p>
            <h3 class="cdt-product-card__title">
              {{ section.settings.collection_product_3_title | default: 'צעצוע עץ דובי' }}
            </h3>
            <div class="cdt-product-card__prices">
              <span class="cdt-product-card__price">
                {{ section.settings.collection_product_3_price | default: '₪ 120' }}
              </span>
              <span class="cdt-product-card__club-price">
                {{ section.settings.collection_product_3_club_price | default: '₪ 99 לחברי מועדון' }}
              </span>
            </div>
            <div class="cdt-product-card__actions">
              <a href="#" class="cdt-button cdt-button--primary cdt-product-card__cta">
                {{ section.settings.collection_product_3_cta | default: 'הוסף לסל' }}
              </a>
            </div>
          </div>
        </div>

        <!-- Product Card 4 -->
        <div class="cdt-product-card">
          <div class="cdt-product-card__image-wrapper">
            {%- if section.settings.collection_product_4_image != blank -%}
              {{ section.settings.collection_product_4_image
                | image_url: width: 400
                | image_tag: loading: 'lazy', alt: section.settings.collection_product_4_title
              }}
            {%- else -%}
              <div class="cdt-product-card__placeholder">
                תמונת מוצר
              </div>
            {%- endif -%}
          </div>
          <div class="cdt-product-card__content">
            <p class="cdt-product-card__brand">
              {{ section.settings.collection_product_4_brand | default: 'מותג לדוגמה' }}
            </p>
            <h3 class="cdt-product-card__title">
              {{ section.settings.collection_product_4_title | default: 'חדר תינוקות סט מלא' }}
            </h3>
            <div class="cdt-product-card__prices">
              <span class="cdt-product-card__price">
                {{ section.settings.collection_product_4_price | default: '₪ 3,990' }}
              </span>
              <span class="cdt-product-card__club-price">
                {{ section.settings.collection_product_4_club_price | default: '₪ 3,490 לחברי מועדון' }}
              </span>
            </div>
            <div class="cdt-product-card__actions">
              <a href="#" class="cdt-button cdt-button--primary cdt-product-card__cta">
                {{ section.settings.collection_product_4_cta | default: 'הוסף לסל' }}
              </a>
            </div>
          </div>
        </div>
      </div>

      <p class="cdt-note">
        {{ section.settings.collection_note | default: 'דוגמה לתצוגת קולקציה עם גריד של כרטיסי מוצר. הגריד מותאם למובייל (עמודה אחת) ולטאבלט/דסקטופ (2-4 עמודות).' }}
      </p>
    </div>

    <!-- CART PAGE EXAMPLE -->
    <div class="custom-design-test__group">
      <h2 class="custom-design-test__group-title">
        {{ section.settings.cart_group_title | default: 'דוגמה לעגלת קניות' }}
      </h2>

      <div class="cdt-cart">
        <div class="cdt-cart__items">
          <!-- Cart Item 1 -->
          <div class="cdt-cart-item">
            <div class="cdt-cart-item__image">
              {%- if section.settings.cart_item_1_image != blank -%}
                {{ section.settings.cart_item_1_image
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', alt: section.settings.cart_item_1_title
                }}
              {%- else -%}
                <div class="cdt-cart-item__placeholder">
                  תמונה
                </div>
              {%- endif -%}
            </div>
            <div class="cdt-cart-item__details">
              <h3 class="cdt-cart-item__title">
                {{ section.settings.cart_item_1_title | default: 'מיטת תינוק דגם עמית לבן' }}
              </h3>
              <p class="cdt-cart-item__variant">
                {{ section.settings.cart_item_1_variant | default: 'גודל: סטנדרטי' }}
              </p>
              <div class="cdt-cart-item__price">
                {{ section.settings.cart_item_1_price | default: '₪ 1,390' }}
              </div>
            </div>
            <div class="cdt-cart-item__quantity">
              <label class="cdt-cart-item__quantity-label">כמות:</label>
              <div class="cdt-quantity-selector">
                <button type="button" class="cdt-quantity-selector__button" aria-label="הפחת כמות">−</button>
                <input type="number" class="cdt-quantity-selector__input" value="1" min="1" readonly>
                <button type="button" class="cdt-quantity-selector__button" aria-label="הוסף כמות">+</button>
              </div>
            </div>
            <div class="cdt-cart-item__total">
              <span class="cdt-cart-item__total-label">סה"כ:</span>
              <span class="cdt-cart-item__total-price">{{ section.settings.cart_item_1_total | default: '₪ 1,390' }}</span>
            </div>
            <button type="button" class="cdt-cart-item__remove" aria-label="הסר מהעגלה">
              ×
            </button>
          </div>

          <!-- Cart Item 2 -->
          <div class="cdt-cart-item">
            <div class="cdt-cart-item__image">
              {%- if section.settings.cart_item_2_image != blank -%}
                {{ section.settings.cart_item_2_image
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', alt: section.settings.cart_item_2_title
                }}
              {%- else -%}
                <div class="cdt-cart-item__placeholder">
                  תמונה
                </div>
              {%- endif -%}
            </div>
            <div class="cdt-cart-item__details">
              <h3 class="cdt-cart-item__title">
                {{ section.settings.cart_item_2_title | default: 'שידת החתלה דגם נועה' }}
              </h3>
              <p class="cdt-cart-item__variant">
                {{ section.settings.cart_item_2_variant | default: 'צבע: לבן' }}
              </p>
              <div class="cdt-cart-item__price">
                {{ section.settings.cart_item_2_price | default: '₪ 890' }}
              </div>
            </div>
            <div class="cdt-cart-item__quantity">
              <label class="cdt-cart-item__quantity-label">כמות:</label>
              <div class="cdt-quantity-selector">
                <button type="button" class="cdt-quantity-selector__button" aria-label="הפחת כמות">−</button>
                <input type="number" class="cdt-quantity-selector__input" value="2" min="1" readonly>
                <button type="button" class="cdt-quantity-selector__button" aria-label="הוסף כמות">+</button>
              </div>
            </div>
            <div class="cdt-cart-item__total">
              <span class="cdt-cart-item__total-label">סה"כ:</span>
              <span class="cdt-cart-item__total-price">{{ section.settings.cart_item_2_total | default: '₪ 1,780' }}</span>
            </div>
            <button type="button" class="cdt-cart-item__remove" aria-label="הסר מהעגלה">
              ×
            </button>
          </div>
        </div>

        <div class="cdt-cart__summary">
          <div class="cdt-cart-summary">
            <h3 class="cdt-cart-summary__title">
              {{ section.settings.cart_summary_title | default: 'סיכום הזמנה' }}
            </h3>
            <div class="cdt-cart-summary__row">
              <span class="cdt-cart-summary__label">סה"כ ביניים:</span>
              <span class="cdt-cart-summary__value">{{ section.settings.cart_subtotal | default: '₪ 3,170' }}</span>
            </div>
            <div class="cdt-cart-summary__row">
              <span class="cdt-cart-summary__label">משלוח:</span>
              <span class="cdt-cart-summary__value">{{ section.settings.cart_shipping | default: 'חינם' }}</span>
            </div>
            <div class="cdt-cart-summary__row cdt-cart-summary__row--total">
              <span class="cdt-cart-summary__label">סה"כ לתשלום:</span>
              <span class="cdt-cart-summary__value">{{ section.settings.cart_total | default: '₪ 3,170' }}</span>
            </div>
            <div class="cdt-cart-summary__actions">
              <button type="button" class="cdt-button cdt-button--primary cdt-cart-summary__checkout">
                {{ section.settings.cart_checkout_button | default: 'המשך לתשלום' }}
              </button>
              <button type="button" class="cdt-button cdt-button--secondary cdt-cart-summary__update">
                {{ section.settings.cart_update_button | default: 'עדכן עגלה' }}
              </button>
            </div>
            <p class="cdt-cart-summary__note">
              {{ section.settings.cart_summary_note | default: 'משלוח חינם על הזמנות מעל ₪ 500' }}
            </p>
          </div>
        </div>
      </div>

      <p class="cdt-note">
        {{ section.settings.cart_note | default: 'דוגמה לעגלת קניות עם רשימת פריטים, בחירת כמות, וסיכום הזמנה. העיצוב מותאם למובייל ולמסכים גדולים יותר.' }}
      </p>
    </div>

  </div>
</section>

{% stylesheet %}
  .section-{{ section.id }}.custom-design-test {
    direction: rtl;
    text-align: right;
    background-color: #FFFFFF; /* design.json.colors.background */
    padding: 32px 0 40px;
  }

  .section-{{ section.id }} .custom-design-test__inner {
    display: flex;
    flex-direction: column;
    gap: 32px; /* design.json.spacing.lg */
  }

  .section-{{ section.id }} .custom-design-test__group {
    padding: 24px;
    border-radius: 12px; /* design.json.borders.radius.md */
    border: 1px solid #F0F0F0; /* design.json.colors.borderLight */
    background-color: #F9F9F9; /* design.json.colors.backgroundSecondary */
  }

  .section-{{ section.id }} .custom-design-test__group-title {
    margin: 0 0 16px;
    font-family: 'Heebo', sans-serif;
    font-size: 20px; /* design.json.typography.fontSizes.xl */
    font-weight: 600;
    color: #333333; /* design.json.colors.text */
  }

  /* TYPOGRAPHY EXAMPLES */
  .section-{{ section.id }} .cdt-heading-1 {
    font-family: 'Heebo', sans-serif;
    font-size: 32px; /* like productPage.productTitle */
    font-weight: 700;
    color: #333333;
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .cdt-heading-2 {
    font-family: 'Heebo', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #333333;
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .cdt-heading-3 {
    font-family: 'Heebo', sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #666666;
    margin: 0 0 12px;
  }

  .section-{{ section.id }} .cdt-body {
    font-family: 'Assistant', sans-serif;
    font-size: 16px; /* design.json.typography.fontSizes.base */
    font-weight: 400;
    color: #333333;
    line-height: 1.5;
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .cdt-body-small {
    font-family: 'Assistant', sans-serif;
    font-size: 14px; /* design.json.typography.fontSizes.sm */
    font-weight: 400;
    color: #666666;
    line-height: 1.4;
    margin: 0;
  }

  .section-{{ section.id }} .cdt-note {
    margin-top: 8px;
    font-size: 14px;
    color: #999999; /* design.json.colors.textLight */
  }

  /* BUTTONS */
  .section-{{ section.id }} .custom-design-test__buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .section-{{ section.id }} .cdt-button {
    display: inline-block;
    padding: 12px 24px; /* design.json.components.button.primary.padding */
    border-radius: 12px; /* design.json.components.button.primary.borderRadius */
    font-family: 'Assistant', sans-serif;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 250ms ease;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }} .cdt-button--primary {
    background: linear-gradient(135deg, #E5D4C0 0%, #CDB9A2 50%, #B8A68F 100%);
    color: #FFFFFF;
    border: none;
    box-shadow: 0 4px 12px rgba(205, 185, 162, 0.3), 
                0 2px 4px rgba(184, 166, 143, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .section-{{ section.id }} .cdt-button--primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, 
      transparent, 
      rgba(255, 255, 255, 0.3), 
      transparent
    );
    transition: left 0.5s ease;
  }

  .section-{{ section.id }} .cdt-button--primary:hover {
    background: linear-gradient(135deg, #D4C4B0 0%, #B8A68F 50%, #A8957F 100%);
    box-shadow: 0 6px 16px rgba(205, 185, 162, 0.4), 
                0 3px 6px rgba(184, 166, 143, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .section-{{ section.id }} .cdt-button--primary:hover::before {
    left: 100%;
  }

  .section-{{ section.id }} .cdt-button--secondary {
    background-color: transparent;
    color: #333333;
    border: 1px solid #E0E0E0; /* design.json.colors.border */
  }

  .section-{{ section.id }} .cdt-button--secondary:hover {
    background-color: #F5F5F5; /* design.json.colors.secondary */
  }

  .section-{{ section.id }} .cdt-button-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%; /* design.json.components.button.icon.borderRadius */
    background: linear-gradient(135deg, #E5D4C0 0%, #CDB9A2 50%, #B8A68F 100%);
    color: #FFFFFF;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(205, 185, 162, 0.3), 
                0 2px 4px rgba(184, 166, 143, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 250ms ease;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }} .cdt-button-icon::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
