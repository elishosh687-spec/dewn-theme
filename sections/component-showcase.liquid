{%- comment -%}
  Component Showcase Section
  This section displays all basic design components according to design.json
  Used for testing and validating the design system before building real sections
  ALL values must come from design.json - if something looks wrong, fix design.json, not this code!
{%- endcomment -%}

{%- style -%}
  /* Base Container - using design.json spacing */
  .component-showcase-{{ section.id }} {
    padding: 32px 16px; /* design.json spacing: xl, md */
    background: #FFFFFF; /* design.json colors.background */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; /* design.json typography.fontFamily.primary */
    max-width: 1200px;
    margin: 0 auto;
  }

  @media screen and (min-width: 768px) {
    .component-showcase-{{ section.id }} {
      padding: 48px 32px; /* design.json spacing: 2xl, xl */
    }
  }

  /* Section Dividers */
  .component-showcase-{{ section.id }} .showcase-section {
    margin-bottom: 48px; /* design.json spacing: 2xl */
    padding-bottom: 32px; /* design.json spacing: xl */
    border-bottom: 1px solid #E0E0E0; /* design.json colors.border */
  }

  .component-showcase-{{ section.id }} .showcase-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .component-showcase-{{ section.id }} .showcase-title {
    font-size: 24px; /* design.json typography.fontSizes.2xl */
    font-weight: 600; /* design.json typography.fontWeights.semibold */
    line-height: 1.2; /* design.json typography.lineHeights.tight */
    color: #333333; /* design.json colors.text */
    margin: 0 0 24px 0; /* design.json spacing: 0, 0, lg, 0 */
    font-family: inherit;
  }

  /* Buttons - using design.json button values */
  .component-showcase-{{ section.id }} .btn-primary {
    background: #D4C2B0; /* design.json components.button.primary.background */
    color: #FFFFFF; /* design.json components.button.primary.text */
    border-radius: 6px; /* design.json components.button.primary.borderRadius */
    padding: 12px 24px; /* design.json components.button.primary.padding */
    font-weight: 500; /* design.json components.button.primary.fontWeight */
    font-size: 16px; /* design.json components.button.primary.fontSize */
    border: none;
    cursor: pointer;
    display: inline-block;
    text-decoration: none;
    transition: all 300ms ease-in-out; /* design.json transitions.normal + easing */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} .btn-primary:hover {
    opacity: 0.9;
  }

  .component-showcase-{{ section.id }} .btn-secondary {
    background: transparent; /* design.json components.button.secondary.background */
    color: #333333; /* design.json components.button.secondary.text */
    border: 1px solid #333333; /* design.json components.button.secondary.border */
    border-radius: 6px; /* design.json components.button.secondary.borderRadius */
    padding: 12px 24px; /* design.json components.button.secondary.padding */
    font-weight: 500; /* design.json components.button.secondary.fontWeight */
    font-size: 16px; /* design.json components.button.secondary.fontSize */
    cursor: pointer;
    display: inline-block;
    text-decoration: none;
    transition: all 300ms ease-in-out; /* design.json transitions.normal + easing */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} .btn-secondary:hover {
    background: #333333;
    color: #FFFFFF;
  }

  /* Typography - using design.json typography values */
  .component-showcase-{{ section.id }} h1 {
    font-size: 40px; /* design.json typography.fontSizes.4xl */
    font-weight: 700; /* design.json typography.fontWeights.bold */
    line-height: 1.2; /* design.json typography.lineHeights.tight */
    color: #333333; /* design.json colors.text */
    margin: 0 0 16px 0; /* design.json spacing: 0, 0, md, 0 */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; /* design.json typography.fontFamily.heading */
  }

  .component-showcase-{{ section.id }} h2 {
    font-size: 32px; /* design.json typography.fontSizes.3xl */
    font-weight: 700; /* design.json typography.fontWeights.bold */
    line-height: 1.2; /* design.json typography.lineHeights.tight */
    color: #333333; /* design.json colors.text */
    margin: 0 0 16px 0; /* design.json spacing: 0, 0, md, 0 */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} h3 {
    font-size: 24px; /* design.json typography.fontSizes.2xl */
    font-weight: 600; /* design.json typography.fontWeights.semibold */
    line-height: 1.2; /* design.json typography.lineHeights.tight */
    color: #333333; /* design.json colors.text */
    margin: 0 0 16px 0; /* design.json spacing: 0, 0, md, 0 */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} p {
    font-size: 16px; /* design.json typography.fontSizes.base */
    font-weight: 400; /* design.json typography.fontWeights.normal */
    line-height: 1.5; /* design.json typography.lineHeights.normal */
    color: #333333; /* design.json colors.text */
    margin: 0 0 16px 0; /* design.json spacing: 0, 0, md, 0 */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} .text-light {
    color: #666666; /* design.json colors.textLight */
  }

  /* Product Card - using design.json productCard values */
  .component-showcase-{{ section.id }} .product-card {
    background: #FFFFFF; /* design.json components.productCard.background */
    border-radius: 0; /* design.json components.productCard.borderRadius */
    padding: 16px; /* design.json components.productCard.padding */
    border: 1px solid #E0E0E0; /* design.json colors.border */
    max-width: 300px;
    display: flex;
    flex-direction: column;
  }

  .component-showcase-{{ section.id }} .product-card-image {
    width: 100%;
    aspect-ratio: 1 / 1; /* design.json components.productCard.imageAspectRatio */
    background: #F8F8F0; /* design.json colors.backgroundSecondary */
    margin-bottom: 16px; /* design.json spacing.md */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666666; /* design.json colors.textLight */
    font-size: 14px; /* design.json typography.fontSizes.sm */
  }

  .component-showcase-{{ section.id }} .product-card-name {
    font-size: 18px; /* design.json components.productCard.productNameSize */
    font-weight: 600; /* design.json components.productCard.productNameWeight */
    color: #333333; /* design.json colors.text */
    margin-bottom: 8px; /* design.json spacing.sm */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} .product-card-price {
    font-size: 20px; /* design.json components.productCard.priceSize */
    font-weight: 700; /* design.json components.productCard.priceWeight */
    color: #333333; /* design.json colors.text */
    margin-bottom: 4px; /* design.json spacing.xs */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} .product-card-original-price {
    font-size: 16px; /* design.json components.productCard.originalPriceSize */
    color: #666666; /* design.json components.productCard.originalPriceColor */
    text-decoration: line-through; /* design.json components.productCard.originalPriceDecoration */
    margin-bottom: 16px; /* design.json spacing.md */
    font-family: inherit;
  }

  /* Discount Badge - using design.json discountBadge values */
  .component-showcase-{{ section.id }} .discount-badge {
    background: #E74C3C; /* design.json components.discountBadge.background */
    color: #FFFFFF; /* design.json components.discountBadge.text */
    padding: 4px 8px; /* design.json components.discountBadge.padding */
    border-radius: 0; /* design.json components.discountBadge.borderRadius */
    font-size: 14px; /* design.json components.discountBadge.fontSize */
    font-weight: 600; /* design.json components.discountBadge.fontWeight */
    display: inline-block;
    margin-bottom: 8px; /* design.json spacing.sm */
    font-family: inherit;
  }

  /* Input Field */
  .component-showcase-{{ section.id }} .input-field {
    width: 100%;
    max-width: 300px;
    padding: 12px 16px; /* design.json spacing: sm, md */
    border: 1px solid #E0E0E0; /* design.json colors.border */
    border-radius: 6px; /* design.json borders.radius.md */
    font-size: 16px; /* design.json typography.fontSizes.base */
    font-family: inherit;
    color: #333333; /* design.json colors.text */
    margin-bottom: 16px; /* design.json spacing.md */
  }

  .component-showcase-{{ section.id }} .input-field:focus {
    outline: none;
    border-color: #D4C2B0; /* design.json colors.primary */
  }

  /* Links */
  .component-showcase-{{ section.id }} a.link {
    color: #333333; /* design.json colors.text */
    text-decoration: underline;
    font-size: 16px; /* design.json typography.fontSizes.base */
    transition: color 300ms ease-in-out; /* design.json transitions.normal + easing */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} a.link:hover {
    color: #D4C2B0; /* design.json colors.primary */
  }

  /* Lists */
  .component-showcase-{{ section.id }} ul {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0; /* design.json spacing: 0, 0, md, 0 */
  }

  .component-showcase-{{ section.id }} ul li {
    padding: 8px 0; /* design.json spacing.sm, 0 */
    font-size: 16px; /* design.json typography.fontSizes.base */
    color: #333333; /* design.json colors.text */
    border-bottom: 1px solid #E0E0E0; /* design.json colors.border */
    font-family: inherit;
  }

  .component-showcase-{{ section.id }} ul li:last-child {
    border-bottom: none;
  }

  /* Color Palette Display */
  .component-showcase-{{ section.id }} .color-swatch {
    width: 100px;
    height: 100px;
    border: 1px solid #E0E0E0; /* design.json colors.border */
    margin-right: 16px; /* design.json spacing.md */
    margin-bottom: 16px; /* design.json spacing.md */
    display: inline-block;
    vertical-align: top;
  }

  .component-showcase-{{ section.id }} .color-label {
    font-size: 12px; /* design.json typography.fontSizes.xs */
    color: #666666; /* design.json colors.textLight */
    margin-top: 8px; /* design.json spacing.sm */
    font-family: inherit;
  }

  /* Button Group */
  .component-showcase-{{ section.id }} .button-group {
    display: flex;
    gap: 16px; /* design.json spacing.md */
    flex-wrap: wrap;
    margin-bottom: 16px; /* design.json spacing.md */
  }

  /* Navigation Bar - using design.json navigationBar values */
  .component-showcase-{{ section.id }} .nav-bar-wrapper {
    width: 100%;
    margin-bottom: 48px; /* design.json spacing: 2xl */
  }

  .component-showcase-{{ section.id }} .nav-bar {
    background: #DDCBAF; /* design.json components.header.navigationBar.background */
    padding: 16px 24px; /* design.json components.header.navigationBar.padding */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 768px) {
    .component-showcase-{{ section.id }} .nav-bar {
      padding: 16px 48px; /* design.json components.header.navigationBar.paddingDesktop */
    }
  }

  .component-showcase-{{ section.id }} .nav-items {
    display: flex;
    gap: 32px; /* design.json components.header.navigationBar.itemGap */
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    min-width: max-content;
  }

  @media screen and (min-width: 1024px) {
    .component-showcase-{{ section.id }} .nav-items {
      gap: 48px; /* design.json components.header.navigationBar.itemGapDesktop */
    }
  }

  .component-showcase-{{ section.id }} .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px; /* design.json spacing.sm */
    text-decoration: none;
    color: #FFFFFF; /* design.json components.header.navigationBar.textColor */
    transition: opacity 300ms ease-in-out; /* design.json transitions.normal + easing */
    min-width: 80px; /* design.json components.header.navigationBar.itemMinWidth */
    flex-shrink: 0;
  }

  .component-showcase-{{ section.id }} .nav-item:hover {
    opacity: 0.8;
  }

  .component-showcase-{{ section.id }} .nav-icon {
    width: 32px; /* design.json components.header.navigationBar.iconSize */
    height: 32px; /* design.json components.header.navigationBar.iconSize */
    color: #FFFFFF; /* design.json components.header.navigationBar.textColor */
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .component-showcase-{{ section.id }} .nav-icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
  }

  .component-showcase-{{ section.id }} .nav-text {
    font-size: 14px; /* design.json components.header.navigationBar.textSize */
    font-weight: 500; /* design.json components.header.navigationBar.fontWeight */
    line-height: 1.2; /* design.json typography.lineHeights.tight */
    color: #FFFFFF; /* design.json components.header.navigationBar.textColor */
    text-align: center;
    white-space: nowrap;
    font-family: inherit;
  }

  /* Sale Badge Icon in Navigation */
  .component-showcase-{{ section.id }} .sale-badge-icon {
    position: relative;
    width: 32px; /* design.json components.header.saleBadge.size */
    height: 32px; /* design.json components.header.saleBadge.size */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .component-showcase-{{ section.id }} .sale-badge-icon svg {
    width: 100%;
    height: 100%;
  }

  .component-showcase-{{ section.id }} .sale-badge-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 10px; /* design.json components.header.saleBadge.textSize */
    font-weight: 700; /* design.json components.header.saleBadge.fontWeight */
    color: #FFFFFF; /* design.json components.header.saleBadge.textColor */
    line-height: 1;
    font-family: inherit;
  }

  /* Top Slogan Text */
  .component-showcase-{{ section.id }} .nav-slogan {
    text-align: center;
    font-size: 14px; /* design.json typography.fontSizes.sm */
    color: #333333; /* design.json colors.text */
    margin-bottom: 16px; /* design.json spacing.md */
    font-family: inherit;
  }


  /* Responsive */
  @media screen and (max-width: 767px) {
    .component-showcase-{{ section.id }} {
      padding: 24px 16px; /* design.json spacing: lg, md */
    }

    .component-showcase-{{ section.id }} .showcase-section {
      margin-bottom: 32px; /* design.json spacing.xl */
      padding-bottom: 24px; /* design.json spacing.lg */
    }

    .component-showcase-{{ section.id }} h1 {
      font-size: 32px; /* design.json typography.fontSizes.3xl */
    }

    .component-showcase-{{ section.id }} h2 {
      font-size: 24px; /* design.json typography.fontSizes.2xl */
    }
  }
{%- endstyle -%}

