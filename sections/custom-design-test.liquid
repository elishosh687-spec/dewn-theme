  }

  /* COLLECTION GRID */
  .section-{{ section.id }} .cdt-collection-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px; /* design.json.spacing.lg */
  }

  @media (min-width: 768px) {
