      <a href="#" class="btn-primary">הוסף לסל</a>
      <a href="#" class="btn-secondary">למידע נוסף</a>
    </div>
    <p class="text-light">Primary button: background #D4C2B0, Secondary button: transparent with border</p>
  </div>

  <!-- Typography Section -->
  <div class="showcase-section">
    <h2 class="showcase-title">Typography</h2>
