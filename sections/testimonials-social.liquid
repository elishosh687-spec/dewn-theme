    {
      "type": "text",
      "id": "subheading",
      "label": "תת-כותרת",
      "default": "אלפי הורים מרוצים מהמוצרים שלנו"
    },
    {
      "type": "header",
      "content": "ספירת עוקבים"
    },
    {
      "type": "checkbox",
